Funcion multiplicacionNumeros ( num7,num8 )
	f<- num7 * num8;
	Escribir "El resutado de la multiplicación es: ",f;
Fin Funcion

Funcion dividirNumeros ( num5,num6 )
	e<- num5 / num6;
	Escribir "El resultado de la division es: ",e;
Fin Funcion

Funcion restarNumeros (num3,num4 )
	d<- num3 - num4;
	Escribir "El resultado de la resta es: ",d;
Fin Funcion

Funcion sumarNumeros(num1,num2)
	c<- num1 + num2;
	Escribir "El resultado de la suma es: ",c;
Fin Funcion

Algoritmo parametros
	sumarNumeros(50,50);
	restarNumeros(29,5);
	dividirNumeros(20,5);
	multiplicacionNumeros(9,5);
FinAlgoritmo
