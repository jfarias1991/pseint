Algoritmo comentarios
	//Definición de variables
	Definir num1 Como Real;
	Definir num2 Como Real;// Suma tanto enteros como reales
	Definir res Como Real;
	//Solicitud de datos
	Escribir "Ingresa un número para sumar: ";
	Leer num1;
	
	Escribir "Ingresa otro número para sumar: ";
	Leer num2;
	//Asignación de valores
	res <- num1 + num2;
	//Muestra del resultado
	Escribir "El resultado de la suma es: ", res;
FinAlgoritmo
